# Copy to .env and fill in. The .env file is never committed.

# Hugging Face access token. Required to download gated base models.
# Create one at https://huggingface.co/settings/tokens with read permission.
HF_TOKEN=

# Directory holding the Hugging Face cache. Keep it outside the repository so
# that model weights survive rebuilds and are shared between runs.
HF_HOME=

# API key for the synthetic prompt generation endpoint.
NVIDIA_API_KEY=
